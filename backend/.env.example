# Application Configuration
APP_NAME="CyberShield Threat Intelligence API"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security / CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173"

# JWT Authentication Configuration
JWT_SECRET_KEY="change_me_to_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres_password"
DB_NAME="cybershield_db"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/cybershield_db"
